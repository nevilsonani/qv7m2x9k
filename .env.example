# Copy to .env to override defaults. No secrets are needed: the Elexon BMRS API is public.

# "snapshot" (default) reads backend/data/snapshot; "live" fetches from Elexon on start-up.
WINDDESK_DATA_MODE=snapshot

# Pilot window: day-ahead decisions made on these dates (delivery is the next day).
WINDDESK_DECISION_START=2026-01-01
WINDDESK_DECISION_END=2026-01-31

# Serve a built frontend from the API process (set automatically in the Docker image).
# WINDDESK_STATIC_DIR=../frontend/dist

# Allowed browser origins for the Vite dev server.
# WINDDESK_CORS_ORIGINS=["http://localhost:5173"]
